# ── General ──────────────────────────
NODE_ENV=production

# ── Ports (host) ─ distinct range so it never clashes with ComputeHub ─
HTTP_PORT=8200
API_PORT=4200
WEB_PORT=3200
MINIO_PORT=9200
MINIO_CONSOLE_PORT=9201

# ── URLs ─────────────────────────────
WEB_URL=http://localhost:3200
CORS_ORIGINS=http://localhost:3200,http://localhost:8200
NEXT_PUBLIC_API_URL=http://localhost:4200/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4200

# ── PostgreSQL ───────────────────────
POSTGRES_USER=axon
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=axon_db

# ── Redis ────────────────────────────
REDIS_PASSWORD=

# ── MinIO ────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=axon-assets
# Kosongkan = bucket privat + presigned URL (disarankan). Isi hanya bila publik.
MINIO_PUBLIC_URL=
# URL publik API untuk PROXY ASET (gambar tampil lewat API di balik tunnel).
# Contoh: https://<url-tunnel>/api  (kosong = pakai presigned URL lokal)
ASSET_PUBLIC_BASE=

# ── ComfyUI (GPU node) ───────────────
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Text-to-video: nonaktif sampai model & node video dipasang di ComfyUI.
COMFYUI_VIDEO_ENABLED=false
# ── FLUX.2 text-to-image — cocokkan dengan aset di GPU node ──
COMFYUI_FLUX_UNET=flux2_dev_fp8mixed.safetensors
COMFYUI_FLUX_CLIP=mistral_3_small_flux2_fp8.safetensors
COMFYUI_FLUX_VAE=flux2-vae.safetensors
COMFYUI_FLUX_WEIGHT_DTYPE=default
COMFYUI_FLUX_GUIDANCE=3.5
# LoRA akselerasi opsional (kosong = nonaktif; turbo = 4-8 steps, cepat & hemat GPU):
COMFYUI_FLUX_LORA=
COMFYUI_FLUX_LORA_STRENGTH=1

# ── Job worker ────────────────────
JOB_CONCURRENCY=2

# ── Text Accuracy (Fase 3 — opt-in, default OFF) ──
# Verifikasi OCR + re-render koreksi agar teks pada gambar/video tidak typo.
# Berat di GPU bersama → default OFF; user/admin mengaktifkan per-generate
# (flag verifyText). Butuh OLLAMA_ENABLED=true + model vision terpasang.
TEXT_VERIFY_ENABLED=false
TEXT_VERIFY_MODEL=qwen2.5vl:latest
# Render ulang maksimum bila teks masih salah (selain render pertama):
TEXT_VERIFY_MAX_ATTEMPTS=1
# Batas waktu satu pembacaan OCR (ms); lewat batas = pakai render saat ini:
TEXT_VERIFY_OCR_TIMEOUT_MS=240000
# Jaga model vision tetap hangat antar pembacaan:
TEXT_VERIFY_KEEPALIVE=10m

# ── JWT (generate strong random values!) ──
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

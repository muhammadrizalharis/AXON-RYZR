# ── App ──────────────────────────────
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ────────────
DATABASE_URL=postgresql://axon:secret@localhost:5432/axon_db?schema=public

# ── Redis (Queue + Cache) ────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Object Storage (MinIO) ───────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=axon-assets
# Public base URL used to build asset links (optional; presigned URLs used if empty)
MINIO_PUBLIC_URL=

# ── AI Engine (ComfyUI GPU Node) ─────
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=600000
COMFYUI_POLL_INTERVAL_MS=1500
# ── FLUX.2 text-to-image (cocokkan dengan aset di GPU node) ──
COMFYUI_FLUX_UNET=flux2_dev_fp8mixed.safetensors
COMFYUI_FLUX_CLIP=mistral_3_small_flux2_fp8.safetensors
COMFYUI_FLUX_VAE=flux2-vae.safetensors
COMFYUI_FLUX_WEIGHT_DTYPE=default
COMFYUI_FLUX_GUIDANCE=3.5
COMFYUI_FLUX_LORA=
COMFYUI_FLUX_LORA_STRENGTH=1

# ── Job worker ────────────────────
JOB_CONCURRENCY=2

# ── Auth (JWT) ───────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Rate limiting ────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── Quota / Credits ──────────────────
DEFAULT_USER_CREDITS=100
IMAGE_CREDIT_COST=1
VIDEO_CREDIT_COST=5
MAX_STORAGE_BYTES_PER_USER=5368709120
